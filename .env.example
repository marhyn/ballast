# --- Database ---
# Matches docker-compose.yml — `docker compose up -d` before first run.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ballast

# --- App ---
APP_URL=http://localhost:3000

# --- Auth (better-auth) ---
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# --- Email (Lettr) ---
LETTR_API_KEY=
EMAIL_FROM=no-reply@example.com

# --- Billing ---
# "polar" | "stripe"
BILLING_PROVIDER=polar

POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ENV=sandbox

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
