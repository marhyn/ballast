{
  "name": "ballast",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @ballast/db db:generate",
    "db:migrate": "pnpm --filter @ballast/db db:migrate",
    "db:studio": "pnpm --filter @ballast/db db:studio",
    "auth:generate": "pnpm --filter @ballast/auth auth:generate"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  }
}
