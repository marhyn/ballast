    "lettr": "^1.0.0"
  },
  "devDependencies": {
    "@ballast/config": "workspace:*",
    "@types/node": "^22.10.0",
    "dotenv-cli": "^11.0.0",
    "typescript": "^5.7.0"
  }
}
